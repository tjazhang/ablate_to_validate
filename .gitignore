external/*
!external/.gitkeep

# Local-only working files (editorial drafts, cross-artifact notes,
# scratchpads, Twitter copy, etc.). Everything under local/ stays on
# disk but never reaches the public remote. Drop new local files here
# instead of adding per-file gitignore rules.
local/

__pycache__/
*.pyc
*.pyo
*.pyd
*.log
*.tmp
*.swp
.DS_Store
.idea/
.vscode/
.pytest_cache/
.cache/
.mamba/
.micromamba/
.conda/
.venv/
tools/__pycache__/
# Generated maintenance notes from repo-cleanup tooling.
methods/*/UPSTREAM_DIFF.md
methods/*/POLISHED_*.md
methods/*/REMOVE_CANDIDATES.md
methods/llava/wandb/
methods/llava/checkpoints/
methods/llava/data/evals/
methods/llava/logs/
methods/llava/runs/
methods/qwen/qwen-vl-finetune/output/
methods/qwen/qwen-vl-finetune/wandb/
methods/qwen/qwen-vl-finetune/logs/
